generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  imageUrl     String?
  role         Role          @default(USER)
  approved     Boolean       @default(false)
  restricted   Boolean       @default(false)
  projects     Project[]     @relation("UserProjects")
  userProjects ProjectUser[]
  createdTasks Task[]        @relation("CreatedTasks")
  tasks        Task[]
  assistanceRequests AssistanceRequest[] @relation("CreatedAssistanceRequests")
  resolvedAssistanceRequests AssistanceRequest[] @relation("ResolvedAssistanceRequests")
  comments     Comment[]
  commentReactions CommentReaction[] // Reactions to comments created by this user
  attachments  Attachment[] // Nouvelle relation pour les pièces jointes
}

model Project {
  id                  String        @id @default(uuid())
  name                String
  description         String?
  isConsultantProject Boolean       @default(false) // New field for consultant projects
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  inviteCode          String        @unique
  createdById         String
  createdBy           User          @relation("UserProjects", fields: [createdById], references: [id], onDelete: Cascade)
  users               ProjectUser[]
  tasks               Task[]
  assistanceRequests  AssistanceRequest[] @relation("AssistanceRequestsOnProjects")
}

model Task {
  id                  String    @id @default(uuid())
  name                String
  description         String
  status              String    @default("To Do")
  priority            Priority  @default(LOW)
  deadline            DateTime?
  projectId           String
  userId              String?
  createdById         String
  solutionDescription String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           User      @relation("CreatedTasks", fields: [createdById], references: [id])
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User?     @relation(fields: [userId], references: [id])
  comments            Comment[]
  attachments         Attachment[] // Nouvelle relation pour les pièces jointes
}

model ProjectUser {
  id        String  @id @default(uuid())
  userId    String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, projectId])
}

enum Role {
  USER
  ADMIN
  CONSULTANT
}

model UserRequest {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  password  String   // Mot de passe en hash (ou temporaire)
  createdAt DateTime @default(now())
  status    String   @default("pending") // pending, approved, rejected
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  LATE // Ajout de la nouvelle priorité 'LATE'
  UNDEFINED // Ajout de la priorité 'UNDEFINED'
}

model AssistanceRequest {
  id              String    @id @default(uuid())
  consultantId    String
  consultant      User      @relation("CreatedAssistanceRequests", fields: [consultantId], references: [id])
  projectId       String? // Optional, the ID of the project for which assistance is requested
  project         Project?  @relation("AssistanceRequestsOnProjects", fields: [projectId], references: [id])
  message         String    // Description of the assistance required
  status          String    @default("pending") // pending, resolved, rejected
  createdAt       DateTime  @default(now())
  resolvedById    String? // ID of the user who resolved the request
  resolvedBy      User?     @relation("ResolvedAssistanceRequests", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  // Task details for requests that include a task proposal
  taskName        String?
  taskDescription String?
  taskPriority    Priority?
  taskDeadline    DateTime?
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?  // Parent comment for replies
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies") // Replies to this comment
  reactions CommentReaction[] // Reactions to this comment
}

enum ReactionType {
  UPVOTE
  DOWNVOTE
}

model CommentReaction {
  id        String       @id @default(uuid())
  type      ReactionType @default(UPVOTE) // Changed from emoji: String to type: ReactionType with default
  createdAt DateTime     @default(now())
  commentId String
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model Attachment {
  id           String    @id @default(uuid())
  name         String
  url          String
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
}
